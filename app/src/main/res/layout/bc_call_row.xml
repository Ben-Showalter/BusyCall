<?xml version="1.0" encoding="utf-8"?>
<!-- A call-log row (Home): a green/red phone icon with an arrow, the name, then
     "Ohio · to Office · 9:42". The row is the focus and click target (guide §2). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="52dp"
    android:background="@drawable/bc_focus_row"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:clickable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/bc_gutter"
    android:paddingTop="4dp"
    android:paddingEnd="@dimen/bc_gutter"
    android:paddingBottom="4dp">

    <ImageView
        android:id="@+id/bc_call_row_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="10dp"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/bc_call_row_name"
            style="@style/BcText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/bc_call_row_line"
            style="@style/BcText.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
