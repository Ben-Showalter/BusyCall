<?xml version="1.0" encoding="utf-8"?>
<!-- A long-list screen (Contacts, Blocked calls): title bar, an optional hint line, a recycled
     ListView (ui/RowList) that keeps focus and moves its selection, footer. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bc_background"
    android:orientation="vertical">

    <include layout="@layout/bc_titlebar" />
    <include layout="@layout/bc_oncall_bar" />

    <TextView
        android:id="@+id/bc_list_hint"
        style="@style/BcText.Meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="3"
        android:paddingStart="@dimen/bc_gutter"
        android:paddingTop="4dp"
        android:paddingEnd="@dimen/bc_gutter"
        android:paddingBottom="4dp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/bc_listview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:clipToPadding="false"
        android:focusable="true"
        android:focusableInTouchMode="false"
        android:scrollbars="none" />

    <include layout="@layout/bc_footer" />
</LinearLayout>
