<?xml version="1.0" encoding="utf-8"?>
<!-- A plain list screen: title bar, an optional hint line, focusable rows, footer. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bc_background"
    android:orientation="vertical">

    <include layout="@layout/bc_titlebar" />
    <include layout="@layout/bc_oncall_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:focusable="false"
        android:descendantFocusability="afterDescendants">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/bc_list_hint"
                style="@style/BcText.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="3"
                android:paddingStart="@dimen/bc_gutter"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/bc_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:descendantFocusability="afterDescendants"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/bc_footer" />
</LinearLayout>
