<?xml version="1.0" encoding="utf-8"?>
<!-- Number setup (PLAN.md S8). Plain EditTexts with the phone's own keyboard (guide §3).
     Ends with "More options…", because the T9 keyboard can take the softkeys while typing. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bc_background"
    android:orientation="vertical">

    <include layout="@layout/bc_titlebar" />
    <include layout="@layout/bc_oncall_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:focusable="false"
        android:descendantFocusability="afterDescendants">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/bc_gutter"
            android:paddingEnd="@dimen/bc_gutter"
            android:paddingBottom="@dimen/bc_gutter">

            <!-- Error in plain words; fixed place at the top so it's seen. -->
            <TextView
                android:id="@+id/bc_setup_error"
                style="@style/BcText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="4"
                android:paddingTop="6dp"
                android:textColor="@color/bc_text_alert"
                android:visibility="gone" />

            <TextView style="@style/BcText.Label" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/bc_field_name" />
            <EditText
                android:id="@+id/bc_setup_name"
                style="@style/BcField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/bc_field_name_hint"
                android:inputType="textCapWords|textNoSuggestions"
                android:importantForAutofill="no" />

            <TextView style="@style/BcText.Label" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/bc_field_server" />
            <EditText
                android:id="@+id/bc_setup_server"
                style="@style/BcField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/bc_field_server_hint"
                android:inputType="textUri|textNoSuggestions"
                android:importantForAutofill="no" />

            <TextView style="@style/BcText.Label" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/bc_field_port" />
            <EditText
                android:id="@+id/bc_setup_port"
                style="@style/BcField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/bc_field_port_hint"
                android:inputType="number"
                android:maxLength="5"
                android:importantForAutofill="no" />

            <TextView style="@style/BcText.Label" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/bc_field_user" />
            <EditText
                android:id="@+id/bc_setup_user"
                style="@style/BcField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text|textNoSuggestions"
                android:importantForAutofill="no" />

            <TextView style="@style/BcText.Label" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/bc_field_password" />
            <EditText
                android:id="@+id/bc_setup_password"
                style="@style/BcField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:importantForAutofill="no" />

            <TextView
                android:id="@+id/bc_setup_password_note"
                style="@style/BcText.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:text="@string/bc_field_password_keep"
                android:visibility="gone" />

            <!-- Connection: a row that opens a menu (UDP / TCP / TLS). -->
            <LinearLayout
                android:id="@+id/bc_setup_transport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:minHeight="@dimen/bc_row_min_height"
                android:background="@drawable/bc_focus_row"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="@dimen/bc_gutter"
                android:paddingEnd="@dimen/bc_gutter">

                <TextView style="@style/BcText.Meta" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/bc_field_connection" />
                <TextView
                    android:id="@+id/bc_setup_transport_value"
                    style="@style/BcText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Numbers starting with +: a row that opens a menu (drop / keep / replace the +). -->
            <LinearLayout
                android:id="@+id/bc_setup_plus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:minHeight="@dimen/bc_row_min_height"
                android:background="@drawable/bc_focus_row"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="@dimen/bc_gutter"
                android:paddingEnd="@dimen/bc_gutter">

                <TextView style="@style/BcText.Meta" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/bc_field_plus" />
                <TextView
                    android:id="@+id/bc_setup_plus_value"
                    style="@style/BcText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView style="@style/BcText.Label" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/bc_field_auth_user" />
            <EditText
                android:id="@+id/bc_setup_auth_user"
                style="@style/BcField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/bc_field_auth_user_hint"
                android:inputType="text|textNoSuggestions"
                android:importantForAutofill="no" />

            <TextView style="@style/BcText.Label" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/bc_field_voicemail" />
            <EditText
                android:id="@+id/bc_setup_voicemail"
                style="@style/BcField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/bc_field_voicemail_hint"
                android:inputType="phone"
                android:importantForAutofill="no" />

            <TextView
                android:id="@+id/bc_setup_save"
                style="@style/BcButton.Call"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/bc_save_connect" />

            <TextView
                android:id="@+id/bc_setup_more"
                style="@style/BcButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/bc_more_options" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/bc_footer" />
</LinearLayout>
