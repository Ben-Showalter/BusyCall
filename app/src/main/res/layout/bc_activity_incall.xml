<?xml version="1.0" encoding="utf-8"?>
<!-- In a call (PLAN.md S5): timer, which number, who, Speaker / Mute / Hold, End call.
     Keypad digits send tones directly; the line under the name shows what was sent. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bc_background"
    android:orientation="vertical">

    <include layout="@layout/bc_titlebar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:focusable="false"
        android:descendantFocusability="afterDescendants">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/bc_gutter">

            <TextView
                android:id="@+id/bc_call_to"
                style="@style/BcText.Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/bc_accent_soft" />

            <TextView
                android:id="@+id/bc_call_name"
                style="@style/BcText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="2"
                android:paddingTop="4dp"
                android:textSize="@dimen/bc_text_header" />

            <TextView
                android:id="@+id/bc_call_number"
                style="@style/BcText.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center" />

            <!-- Fixed height so the layout doesn't jump when tones are sent (guide §4). -->
            <TextView
                android:id="@+id/bc_call_sent"
                style="@style/BcText.Meta"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:gravity="center"
                android:textColor="@color/bc_accent" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/bc_call_speaker"
                    style="@style/BcButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="@dimen/bc_text_label"
                    android:text="@string/bc_call_speaker" />

                <TextView
                    android:id="@+id/bc_call_mute"
                    style="@style/BcButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:textSize="@dimen/bc_text_label"
                    android:text="@string/bc_call_mute" />

                <TextView
                    android:id="@+id/bc_call_hold"
                    style="@style/BcButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:textSize="@dimen/bc_text_label"
                    android:text="@string/bc_call_hold" />
            </LinearLayout>

            <TextView
                android:id="@+id/bc_call_end"
                style="@style/BcButton.End"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/bc_call_end" />

            <TextView
                style="@style/BcText.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="2"
                android:paddingTop="6dp"
                android:text="@string/bc_incall_hint" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/bc_footer" />
</LinearLayout>
