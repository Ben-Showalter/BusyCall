<?xml version="1.0" encoding="utf-8"?>
<!-- Home (PLAN.md S1) is the call log; above it only numbers that can't connect. Scrolls by focus only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bc_background"
    android:orientation="vertical">

    <include layout="@layout/bc_titlebar" />
    <include layout="@layout/bc_oncall_bar" />

    <!-- Starting / permission problem, with Retry. -->
    <TextView
        android:id="@+id/bc_home_message"
        style="@style/BcText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="4"
        android:padding="@dimen/bc_gutter"
        android:visibility="gone" />

    <TextView
        android:id="@+id/bc_home_retry"
        style="@style/BcButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="4dp"
        android:text="@string/bc_retry"
        android:visibility="gone" />

    <TextView
        android:id="@+id/bc_home_calls_empty"
        style="@style/BcText.Meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:paddingStart="@dimen/bc_gutter"
        android:paddingTop="8dp"
        android:text="@string/bc_home_no_recents"
        android:visibility="gone" />

    <!-- Numbers that can't connect (AGENTS §6) or "+ Add a number", then the call log:
         one recycled ListView (ui/RowList) that keeps focus and moves its selection. -->
    <ListView
        android:id="@+id/bc_home_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:clipToPadding="false"
        android:focusable="true"
        android:focusableInTouchMode="false"
        android:scrollbars="none" />

    <include layout="@layout/bc_footer" />
</LinearLayout>
