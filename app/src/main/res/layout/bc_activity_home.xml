<?xml version="1.0" encoding="utf-8"?>
<!-- Home (PLAN.md S1): my numbers with status, then recent calls. Content scrolls by focus only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bc_background"
    android:orientation="vertical">

    <include layout="@layout/bc_titlebar" />
    <include layout="@layout/bc_oncall_bar" />

    <ScrollView
        android:id="@+id/bc_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:focusable="false"
        android:descendantFocusability="afterDescendants">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="4dp">

            <!-- Starting / permission problem, with Retry. Fixed place so the layout doesn't jump. -->
            <TextView
                android:id="@+id/bc_home_message"
                style="@style/BcText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="4"
                android:padding="@dimen/bc_gutter"
                android:visibility="gone" />

            <TextView
                android:id="@+id/bc_home_retry"
                style="@style/BcButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/bc_retry"
                android:visibility="gone" />

            <TextView
                style="@style/BcText.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/bc_home_my_numbers" />

            <LinearLayout
                android:id="@+id/bc_home_numbers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:descendantFocusability="afterDescendants"
                android:orientation="vertical" />

            <TextView
                style="@style/BcText.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/bc_home_recent" />

            <LinearLayout
                android:id="@+id/bc_home_recents"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:descendantFocusability="afterDescendants"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/bc_home_recents_empty"
                style="@style/BcText.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:paddingStart="@dimen/bc_gutter"
                android:paddingTop="4dp"
                android:text="@string/bc_home_no_recents"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/bc_footer" />
</LinearLayout>
