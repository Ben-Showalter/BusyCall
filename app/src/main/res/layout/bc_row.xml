<?xml version="1.0" encoding="utf-8"?>
<!-- A list row: the row itself is the focus and click target (guide §2). Rows grow with text
     (minHeight, never a fixed height). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/bc_row_min_height"
    android:background="@drawable/bc_focus_row"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:clickable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/bc_gutter"
    android:paddingTop="3dp"
    android:paddingEnd="@dimen/bc_gutter"
    android:paddingBottom="3dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/bc_row_title"
            style="@style/BcText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawablePadding="6dp" />

        <TextView
            android:id="@+id/bc_row_subtitle"
            style="@style/BcText.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        android:id="@+id/bc_row_trailing"
        style="@style/BcText.Meta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:visibility="gone" />
</LinearLayout>
