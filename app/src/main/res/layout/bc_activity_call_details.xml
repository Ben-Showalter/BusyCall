<?xml version="1.0" encoding="utf-8"?>
<!-- Call details (OK on a Home row): who, where the number is from (with a map), the call, and
     Call back · Add to contacts / Open contact · Block · Delete. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bc_background"
    android:orientation="vertical">

    <include layout="@layout/bc_titlebar" />
    <include layout="@layout/bc_oncall_bar" />

    <ScrollView
        android:id="@+id/bc_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:focusable="false"
        android:descendantFocusability="afterDescendants">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/bc_gutter"
            android:paddingEnd="@dimen/bc_gutter"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/bc_details_name"
                style="@style/BcText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:textSize="@dimen/bc_text_header" />

            <TextView
                android:id="@+id/bc_details_number"
                style="@style/BcText.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/bc_details_call"
                style="@style/BcText.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/bc_details_place"
                style="@style/BcText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:textColor="@color/bc_accent_soft"
                android:textSize="@dimen/bc_text_label" />

            <com.busycall.app.ui.PlaceMapView
                android:id="@+id/bc_details_map"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/bc_details_call_back"
                style="@style/BcButton.Call"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/bc_calllog_call_back" />

            <LinearLayout
                android:id="@+id/bc_details_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:descendantFocusability="afterDescendants"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/bc_footer" />
</LinearLayout>
