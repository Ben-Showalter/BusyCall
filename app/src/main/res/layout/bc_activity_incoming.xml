<?xml version="1.0" encoding="utf-8"?>
<!-- Incoming call (PLAN.md S4): which number is ringing, who's calling, Answer and Decline. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bc_background"
    android:orientation="vertical">

    <include layout="@layout/bc_titlebar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:focusable="false"
        android:descendantFocusability="afterDescendants">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/bc_gutter">

            <TextView
                android:id="@+id/bc_call_to"
                style="@style/BcText.Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/bc_accent_soft" />

            <TextView
                android:id="@+id/bc_call_name"
                style="@style/BcText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="2"
                android:paddingTop="4dp"
                android:textSize="@dimen/bc_text_header" />

            <TextView
                android:id="@+id/bc_call_number"
                style="@style/BcText.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/bc_call_answer"
                style="@style/BcButton.Call"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/bc_call_answer" />

            <TextView
                android:id="@+id/bc_call_decline"
                style="@style/BcButton.End"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/bc_call_decline" />

            <TextView
                style="@style/BcText.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="2"
                android:paddingTop="8dp"
                android:text="@string/bc_incoming_hint" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/bc_footer" />
</LinearLayout>
