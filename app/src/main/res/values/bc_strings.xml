    <string name="bc_field_server">Server (* types a dot)</string>
    <string name="bc_field_server_hint">pbx.example.org</string>
    <string name="bc_field_port">Port</string>
    <string name="bc_field_port_hint">automatic</string>
    <string name="bc_field_user">Extension or username</string>
    <string name="bc_field_password">Password</string>
    <string name="bc_field_password_keep">Leave empty to keep the saved password.</string>
    <string name="bc_field_connection">Connection</string>
    <!-- Authentication ID; only needed when it differs from the extension. -->
    <string name="bc_field_auth_user">Auth ID</string>
    <string name="bc_field_auth_user_hint">same as extension</string>
    <string name="bc_field_voicemail">Voicemail number</string>
    <string name="bc_field_voicemail_hint">*97</string>
    <string name="bc_save_connect">Save and connect</string>
    <string name="bc_show_password">Show password</string>
    <string name="bc_hide_password">Hide password</string>
    <string name="bc_saved_connecting">Saved. Connecting…</string>

    <!-- Problems saving a number, in plain words -->
    <string name="bc_problem_not_running">The phone service is still starting. Wait a moment, then press Save again.</string>
    <string name="bc_problem_server">Check the server address, e.g. pbx.example.org or 192.168.1.10.</string>
    <string name="bc_problem_port">The port must be a number from 1 to 65535, or empty.</string>
    <string name="bc_problem_user">Check the extension or username: letters, numbers and . - _ only.</string>
    <string name="bc_problem_password">The password can\'t contain a double quote (\") and must be 64 characters or fewer.</string>
    <string name="bc_problem_name">The name can use letters, numbers, spaces and . - _ only.</string>
    <string name="bc_problem_name_taken">Another number already has this name. Choose a different one.</string>
    <string name="bc_problem_exists">This number is already on the phone.</string>
    <string name="bc_problem_allocation">The phone service couldn\'t add this number. Check the details, then press Save again.</string>

    <!-- Setup code found -->
    <string name="bc_found_title">Setup code found</string>
    <string name="bc_found_hint">Check these, then Save. OK on a line to change it.</string>
    <string name="bc_found_footer">BACK to cancel</string>
    <!-- %1$s = the extension, used as the name when none is given -->
    <string name="bc_found_no_name">(none: shows as %1$s)</string>
    <string name="bc_found_user_password">Extension · Password</string>
    <!-- %1$s extension, %2$s hidden password or "none" -->
    <string name="bc_found_user_password_value">%1$s · %2$s</string>
    <string name="bc_found_no_password">no password</string>
    <string name="bc_found_edit">Change details</string>
    <string name="bc_found_check">Check the details, then press Save again.</string>

    <!-- Calls -->
    <string name="bc_incoming_title">Incoming call</string>
    <!-- Keys on the incoming-call screen. -->
    <string name="bc_incoming_hint">CALL answers · END declines · BACK silences</string>
    <string name="bc_call_answer">Answer</string>
    <string name="bc_call_decline">Decline</string>
    <!-- Stops the ringtone without declining. -->
    <string name="bc_call_silence">Silence ringer</string>
