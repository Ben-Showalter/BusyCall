<?xml version="1.0" encoding="utf-8"?>
<!-- BusyCall's own strings. All prefixed bc_ so they never collide with baresip-studio's.
     Screens are 240x320: keep labels short. Placeholders, never concatenation (AGENTS.md §9). -->
<resources>

    <!-- Shared -->
    <!-- Softkey label that opens the screen's menu. -->
    <string name="bc_options">Options</string>
    <string name="bc_ok">OK</string>
    <string name="bc_cancel">Cancel</string>
    <!-- Button: try again after a failure. -->
    <string name="bc_retry">Retry</string>
    <!-- Toast for a key BusyCall doesn't know yet, so new phones can be learned. %1$d keycode, %2$d scan code. -->
    <string name="bc_unknown_key">Unhandled key %1$d (scan %2$d)</string>
    <!-- Row that opens the screen's Options menu; for screens where the keyboard takes the softkeys. -->
    <string name="bc_more_options">More options…</string>

    <!-- Number status -->
    <string name="bc_status_registered">Registered</string>
    <string name="bc_status_connecting">Connecting…</string>
    <string name="bc_status_no_connection">No connection</string>
    <!-- The number is set not to register with its phone system. -->
    <string name="bc_status_off">Off</string>

    <!-- Connection types -->
    <string name="bc_transport_udp">UDP</string>
    <string name="bc_transport_tcp">TCP</string>
    <string name="bc_transport_tls">TLS (secure)</string>

    <!-- Times -->
    <string name="bc_time_just_now">just now</string>
    <!-- %1$d = minutes -->
    <string name="bc_time_minutes_ago">%1$d min ago</string>
    <string name="bc_time_yesterday">yesterday</string>

    <!-- A number's name and extension, e.g. "Office · 104". -->
    <string name="bc_number_title">%1$s · %2$s</string>
    <!-- The default number, marked with a star. %1$s = "Office · 104". -->
    <string name="bc_number_default">★ %1$s</string>
    <!-- Server, connection type and status, e.g. "pbx.example.org · TLS · Registered". -->
    <string name="bc_number_details">%1$s · %2$s · %3$s</string>
    <plurals name="bc_voicemail_count">
        <item quantity="one">%d voicemail</item>
        <item quantity="other">%d voicemail</item>
    </plurals>

    <!-- Home -->
    <string name="bc_home_my_numbers">My numbers</string>
    <string name="bc_home_recent">Recent</string>
    <!-- Footer hint on Home. -->
    <string name="bc_home_hint">0–9 to dial</string>
    <string name="bc_home_starting">Starting the phone service…</string>
    <string name="bc_home_permissions_denied">BusyCall needs the microphone (and notifications) to make and receive calls. Press Retry to allow them.</string>
    <string name="bc_home_no_numbers">No numbers yet</string>
    <string name="bc_home_no_recents">No calls yet</string>
    <string name="bc_recent_missed">Missed</string>
    <string name="bc_recent_incoming">Incoming</string>
    <string name="bc_recent_outgoing">Outgoing</string>
    <!-- Which of the user's numbers a call came in on. %1$s = "Home". -->
    <string name="bc_recent_to">to %1$s</string>
    <!-- Which of the user's numbers a call went out from. %1$s = "Office". -->
    <string name="bc_recent_from">from %1$s</string>
    <!-- Recent-call line: kind, number, time, e.g. "Missed · to Home · 10 min ago". -->
    <string name="bc_recent_line">%1$s · %2$s · %3$s</string>

    <!-- Menus -->
    <string name="bc_menu_numbers">Numbers</string>
    <!-- Temporary: opens baresip's original screens, for calling until BusyCall's own exist. -->
    <string name="bc_menu_classic">Classic screens</string>
    <string name="bc_menu_settings">Settings</string>

    <!-- Numbers -->
    <string name="bc_numbers_title">Numbers</string>
    <string name="bc_numbers_hint">★ = the number the Dialer calls from</string>
    <string name="bc_numbers_footer">OK for choices</string>
    <string name="bc_numbers_add">+ Add a number</string>
    <string name="bc_number_edit">Edit</string>
    <string name="bc_number_make_default">Make default ★</string>
    <string name="bc_number_delete">Delete</string>
    <string name="bc_number_delete_title">Delete number?</string>
    <!-- %1$s = the number's name -->
    <string name="bc_number_delete_message">Delete %1$s from this phone? Its calls in Recent are deleted too.</string>
    <string name="bc_sim_title">Phone (SIM)</string>
    <string name="bc_sim_subtitle">Opens the phone\'s dialer</string>
    <string name="bc_sim_no_dialer">This phone has no dialer app BusyCall can open.</string>

    <!-- Add a number -->
    <string name="bc_add_type">Type it in</string>
    <string name="bc_add_paste">Paste setup link</string>
    <string name="bc_paste_nothing">Nothing copied yet: copy the setup link from your text or email, then try again.</string>
    <string name="bc_paste_not_a_code">This isn\'t a BusyCall setup link. Ask your admin for a BusyCall setup code.</string>
    <string name="bc_paste_too_new">This setup link is for a newer version of BusyCall. Update the app, then try again.</string>
    <string name="bc_paste_no_server">This setup link has no server address. Ask your admin for a new one.</string>
    <string name="bc_paste_no_user">This setup link has no extension or username. Ask your admin for a new one.</string>

