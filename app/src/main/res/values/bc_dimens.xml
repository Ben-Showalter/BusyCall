<?xml version="1.0" encoding="utf-8"?>
<!-- BusyCall sizes for a 240x320 mdpi screen. Larger than the guide's minimums (body 16sp, labels
     14sp, metadata 11sp, headers 18sp): the owner found those too small on the E4810 (2026-11-20). -->
<resources>
    <dimen name="bc_text_header">20sp</dimen>
    <dimen name="bc_text_body">18sp</dimen>
    <dimen name="bc_text_label">16sp</dimen>
    <dimen name="bc_text_meta">14sp</dimen>
    <dimen name="bc_text_softkey">16sp</dimen>
    <!-- In-call ring labels ("Speaker") must fit a third of the ring. -->
    <dimen name="bc_text_petal">12sp</dimen>

    <dimen name="bc_bar_min_height">30dp</dimen>
    <dimen name="bc_row_min_height">46dp</dimen>
    <dimen name="bc_button_min_height">46dp</dimen>
    <dimen name="bc_gutter">8dp</dimen>
    <dimen name="bc_focus_stroke">2dp</dimen>
    <dimen name="bc_corner">8dp</dimen>
    <dimen name="bc_status_dot">8dp</dimen>
    <!-- In-call D-pad ring: the rounded square and its petals. -->
    <dimen name="bc_ring_size">174dp</dimen>
    <dimen name="bc_ring_corner">40dp</dimen>
    <dimen name="bc_petal_corner">12dp</dimen>
</resources>
