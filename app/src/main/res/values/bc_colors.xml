<?xml version="1.0" encoding="utf-8"?>
<!-- BusyCall colour roles (AGENTS.md §9: black with gray accents). Use these names in layouts, never raw hex. -->
<resources>
    <!-- Title and softkey bars (near-black, with a bc_line divider); white text on it is 18:1. -->
    <color name="bc_bar">#FF121214</color>
    <color name="bc_background">#FF000000</color>
    <color name="bc_surface">#FF1C1C1E</color>
    <color name="bc_surface_dialog">#FF26262A</color>
    <color name="bc_line">#FF3A3A3E</color>
    <!-- Behind text over the camera picture. -->
    <color name="bc_scrim">#CC000000</color>

    <color name="bc_text">#FFF2F2F2</color>
    <color name="bc_text_on_bar">#FFFFFFFF</color>
    <color name="bc_text_muted">#FFB8B8B8</color>
    <!-- Missed calls, errors. -->
    <color name="bc_text_alert">#FFFF8A8A</color>
    <color name="bc_accent">#FFD0D0D0</color>
    <color name="bc_accent_soft">#FFE0E0E0</color>
    <color name="bc_footer_hint">#FFC8C8C8</color>

    <!-- Focus: a light-gray ring over a dark-gray tint (the guide's list_row_selector, recoloured). -->
    <color name="bc_focus_ring">#FFBDBDBD</color>
    <color name="bc_focus_tint">#FF2A2A2E</color>

    <!-- Call/Answer green; Decline/End red (kept for meaning). Always with a text label. -->
    <color name="bc_call">#FF1E7A34</color>
    <color name="bc_end">#FFC62828</color>

    <!-- Number status dots. -->
    <color name="bc_status_ok">#FF4CD964</color>
    <color name="bc_status_wait">#FFFFD54F</color>
    <color name="bc_status_off">#FFFF6B6B</color>
</resources>
