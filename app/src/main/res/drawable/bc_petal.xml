<?xml version="1.0" encoding="utf-8"?>
<!-- An action around the in-call D-pad ring: lit (activated) when that thing is on, the app's
     focus ring when focused or pressed. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true" android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bc_accent_soft" />
            <corners android:radius="@dimen/bc_petal_corner" />
            <stroke android:width="@dimen/bc_focus_stroke" android:color="@color/bc_text_on_bar" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bc_accent_soft" />
            <corners android:radius="@dimen/bc_petal_corner" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bc_focus_tint" />
            <corners android:radius="@dimen/bc_petal_corner" />
            <stroke android:width="@dimen/bc_focus_stroke" android:color="@color/bc_focus_ring" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bc_focus_tint" />
            <corners android:radius="@dimen/bc_petal_corner" />
            <stroke android:width="@dimen/bc_focus_stroke" android:color="@color/bc_focus_ring" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
