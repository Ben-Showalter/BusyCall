<?xml version="1.0" encoding="utf-8"?>
<!-- The one focus highlight for rows (guide §2 list_row_selector, recoloured for BusyCall):
     a light-red ring over a dark-red tint. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bc_focus_tint" />
            <corners android:radius="@dimen/bc_corner" />
            <stroke android:width="@dimen/bc_focus_stroke" android:color="@color/bc_focus_ring" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bc_focus_tint" />
            <corners android:radius="@dimen/bc_corner" />
            <stroke android:width="@dimen/bc_focus_stroke" android:color="@color/bc_focus_ring" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
