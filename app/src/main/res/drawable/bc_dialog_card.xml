<?xml version="1.0" encoding="utf-8"?>
<!-- Menus and confirmations: a rounded dark card (as in the previews). The inset keeps the card
     off the screen edges. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="8dp"
    android:insetRight="8dp"
    android:insetTop="8dp"
    android:insetBottom="8dp">
    <shape android:shape="rectangle">
        <solid android:color="@color/bc_surface_dialog" />
        <corners android:radius="@dimen/bc_corner" />
        <stroke android:width="1dp" android:color="@color/bc_line" />
    </shape>
</inset>
